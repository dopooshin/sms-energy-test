<%- include('partials/head', { active: 'logs' }) %>
<div class="page-head">
  <h2>操作日志</h2>
  <p class="muted">记录关键操作（登录、设置发布、账号变更、备份/恢复），可追溯、可审计。只读访客仅见自己的日志。</p>
</div>

<div class="panel">
  <table class="tbl">
    <thead><tr><th>时间</th><th>操作</th><th>对象</th><th>详情</th></tr></thead>
    <tbody>
    <% if (logs.length===0) { %><tr><td colspan="4" class="muted">暂无日志</td></tr><% } %>
    <% logs.forEach(function(l){ %>
      <tr>
        <td class="muted"><%= new Date(l.at).toLocaleString('zh-CN') %></td>
        <td><span class="tag"><%= l.action %></span></td>
        <td><%= l.target || '' %></td>
        <td class="muted"><%= l.detail || '' %></td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</div>
<%- include('partials/foot') %>
